<Project Sdk="Microsoft.NET.Sdk">

  <!-- Opt-in live integration suite for AgentKit's tools in a host-built agent, against Ollama.

       It runs AgentKit's tools and building blocks - ToolPackContextProvider, AsGuarded,
       ToolOutputRetention, UseImagePromotion and AgentKitChatReducer - inside a Microsoft Agent
       Framework ChatClientAgent the test builds itself, over the real OllamaSharp client and a real
       model, which the hermetic unit tests deliberately cannot. It is therefore:
       - NOT part of AgentKit.slnx, so build.ps1 and 'dotnet test' at the repository root never
         build or run it; the build.yaml merge gate compiles it but never runs it;
       - gated a second time inside every test on the AGENTKIT_OLLAMA_LIVE_MODEL environment
         variable, which also names the model to use, so an accidental run contacts nothing;
       - run by hand against an Ollama server, as described in the verification documentation.

       AGENTKIT_OLLAMA_LIVE_HOST names the server (default http://localhost:11434),
       AGENTKIT_OLLAMA_LIVE_NUM_CTX the context length requested (default 16384), and
       AGENTKIT_OLLAMA_LIVE_LOG_DIRECTORY where the run's log is written. -->

  <PropertyGroup>
    <!-- Build Configuration -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Implicit Usings -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test Framework Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Provider: the real OllamaSharp client, the version the Ollama adapter pins. -->
  <ItemGroup>
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Core\DemaConsulting.AgentKit.Core.csproj" />
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Tools\DemaConsulting.AgentKit.Tools.csproj" />
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Agents.ChatClient\DemaConsulting.AgentKit.Agents.ChatClient.csproj" />
  </ItemGroup>

</Project>