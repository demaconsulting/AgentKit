<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>document-assistant</AssemblyName>
    <RootNamespace>DemaConsulting.AgentKit.Samples.DocumentAssistant</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- This is a demonstration application, not a shipped library: it is never packed,
         published, or given an SBOM. Keeping it out of the package pipeline is what lets CI
         build it (as part of the solution) without ever attempting to run or distribute it. -->
    <IsPackable>false</IsPackable>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- The Microsoft Agent Framework and the Copilot SDK mark parts of their agent surface
         with "evaluation only" diagnostics (MAAI001 for the Agent Framework, MCPSDK001 for the
         Copilot permission-decision RPC surface). This sample necessarily consumes that surface to
         build and run an agent, so both diagnostics are suppressed here — the same approach the
         Copilot library project takes for MCPSDK001. -->
    <NoWarn>$(NoWarn);MCPSDK001;MAAI001</NoWarn>
  </PropertyGroup>

  <!-- Project References: the sample composes the shipped Core + Tools packages and both agent
       adapters, and the Ollama package for its model catalog and context sizing. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Core\DemaConsulting.AgentKit.Core.csproj" />
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Tools\DemaConsulting.AgentKit.Tools.csproj" />
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Agents.ChatClient\DemaConsulting.AgentKit.Agents.ChatClient.csproj" />
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Agents.Copilot\DemaConsulting.AgentKit.Agents.Copilot.csproj" />
    <ProjectReference Include="..\..\src\DemaConsulting.AgentKit.Agents.Ollama\DemaConsulting.AgentKit.Agents.Ollama.csproj" />
  </ItemGroup>

  <!-- Copilot Runtime: this sample runs the Copilot CLI installed on the machine (at least
       CopilotCli.MinimumVersion; the user guide's Installing the Copilot CLI says how to check
       it), which is the AgentKit Copilot library's default, so it ships no runtime and needs no
       reference to Microsoft.Copilot.SDK of its own. To run the runtime the SDK bundles instead, pass
       runtimeSource: CopilotRuntimeSource.Bundled to CopilotRuntimeOptions in AgentComposition.cs
       and add <PackageReference Include="Microsoft.Copilot.SDK" Version="..." /> here, at the
       library's version: the SDK then downloads its native runtime (several hundred megabytes) into
       this project's output at build time. -->

  <!-- Package References: OllamaSharp supplies the IChatClient implementation the sample points at
       an Ollama host. It is the only provider dependency the adapters do not already pull in. -->
  <ItemGroup>
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
  </ItemGroup>

  <!-- Code Analysis Dependencies: matched to the library projects so the sample is held to the
       same static-analysis bar as the code it demonstrates. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
